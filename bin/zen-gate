#!/usr/bin/env bash
# zen-gate — 本機所有 Zen 免費層消費端共用的封鎖閘（同一出口 IP，一處被判濫用＝全部停打）。
#
# 為什麼要這支（10-19）：閘原本有兩份、互不讀——dc 寫 ~/.dcq/.zen-gate（epoch 秒），
# Jev adapter 寫 ~/.jevgate/zen-free-status.json（cooldown_until epoch 毫秒＋blocked）。
# dc 的閘 01:46 到期後，Jev 的閘仍在冷卻，06:00 oc-free-check 只看 dc 那份 → 併發探測全池 9 次 403。
#
#   zen-gate until          印兩份閘取最大的到期時間（epoch 秒；0＝沒閘）
#   zen-gate check          閘內 exit 1 並印到期時間；閘外 exit 0
#   zen-gate trip [原因]     判濫用時呼叫：兩份閘都寫到 now+封鎖秒數（只延長不縮短），
#                           由開轉關時 hpush 一則
#   zen-gate ok            上游有正常回應了：刪掉失敗計數檔（streak），下次封鎖回到最短秒數
#   zen-gate halfopen      閘已到期但還有失敗計數 → exit 0（半開：只准探測）；否則 exit 1
#
# 封鎖秒數的延遲倍增（2026-10-21）：借鏡 OmniRoute 的 circuitBreaker
# （src/shared/utils/circuitBreaker.ts：backoffEscalationCount=3、maxBackoffMultiplier=16、halfOpenRequests=1）。
# Zen 免費層判本機 IP 濫用會 403，官方不公布解封期限，固定封 6h 是在猜；照「到期→探測→又被封」
# 的連續輪數倍增：連續 3 輪才開始加倍，之後每輪 ×2。
#   streak ≤3 → DC_ZEN_GATE_S；streak >3 → DC_ZEN_GATE_S × 2^(streak−3)，上限 DC_ZEN_GATE_MAX_S（預設 172800）。
#   streak 計數檔＝$DG.streak（整數）。trip 只在「呼叫當下閘是開的」（兩份最大值 ≤ now）才 +1：
#   閘還關著時重複 trip 是同一場封鎖的重複回報，不加計數。
#   半開：閘到期但 streak 還在 → 只准放 1 個探測（dcq 把 zen 這個 provider 的上限壓到 1）。
#   探測成功（上游正常回應）→ dc 跑 `zen-gate ok` 清掉 streak，退避歸零。
#
# Jev 檔只認 blocked:true 的冷卻：額度冷卻（429）是 Jev 自己模型的額度，不是 IP 封鎖，不擋 dc。
set -u
DG="${DC_ZEN_GATE:-$HOME/.dcq/.zen-gate}"
JS="${JEV_ZEN_STATUS_FILE:-$HOME/.jevgate/zen-free-status.json}"
GATE_S="${DC_ZEN_GATE_S:-21600}"
MAX_S="${DC_ZEN_GATE_MAX_S:-172800}"
STREAK="$DG.streak"
# 閘檔不是正式路徑（測試、手動試跑把 DC_ZEN_GATE／JEV_ZEN_STATUS_FILE 指到暫存檔）就不推播。
# 10-21 實例：工單模型在 shell 手動 trip 5 次，發出 5 則 TG 誤報。DC_PUSH=1 強制推（驗推播的測試配假 hpush 用）。
push_ok() { [ "${DC_PUSH:-}" = 1 ] || { [ "$DG" = "$HOME/.dcq/.zen-gate" ] && [ "$JS" = "$HOME/.jevgate/zen-free-status.json" ]; }; }

dc_until() { local v; v=$(cat "$DG" 2>/dev/null | tr -dc 0-9); echo "${v:-0}"; }
jev_until() {
  [ -f "$JS" ] || { echo 0; return; }
  jq -r 'if .blocked == true and (.cooldown_until|type) == "number" then (.cooldown_until/1000|floor) else 0 end' "$JS" 2>/dev/null || echo 0
}
until_max() { local a b; a=$(dc_until); b=$(jev_until); [ "${b:-0}" -gt "$a" ] && a=$b; echo "$a"; }
# 連續被封的輪數（整數；沒有計數檔＝0）
streak_get() { local v; v=$(cat "$STREAK" 2>/dev/null | tr -dc 0-9); echo "${v:-0}"; }
# 這一次的封鎖秒數：streak ≤3 → GATE_S；streak >3 → GATE_S × 2^(streak−3)，上限 MAX_S
gate_secs() {
  local s="$1" base="$GATE_S" max="$MAX_S" mult=1 i=3 d
  [ "$base" -gt 0 ] || { echo 0; return; }
  while [ "$i" -lt "$s" ]; do
    # 乘積已達上限就停，避免整數溢位
    [ "$mult" -ge $(( max / base )) ] && break
    mult=$(( mult * 2 )); i=$(( i + 1 ))
  done
  d=$(( base * mult ))
  [ "$d" -gt "$max" ] && d="$max"
  echo "$d"
}

case "${1:-}" in
  until) until_max ;;
  check)
    u=$(until_max)
    if [ "$u" -gt "$(date +%s)" ]; then echo "Zen 免費層封鎖閘至 $(date -r "$u" '+%m-%d %H:%M')"; exit 1; fi
    exit 0 ;;
  trip)
    why="${2:-偵測到 403 abusive traffic}"
    now=$(date +%s); old=$(until_max)
    # 閘還關著＝同一場封鎖的重複回報，不加計數；閘已到期（兩份最大值 ≤ now）才是新一輪，streak +1
    if [ "$old" -le "$now" ]; then
      s=$(( $(streak_get) + 1 ))
      mkdir -p "$(dirname "$STREAK")"; echo "$s" > "$STREAK"
    else
      s=$(streak_get)
    fi
    dur=$(gate_secs "$s"); new=$(( now + dur ))
    [ "$old" -gt "$now" ] && was_closed=1 || was_closed=0
    [ "$(dc_until)" -lt "$new" ] && { mkdir -p "$(dirname "$DG")"; echo "$new" > "$DG"; }
    if [ "$(jev_until)" -lt "$new" ]; then
      mkdir -p "$(dirname "$JS")"; tmp="$JS.$$.tmp"
      at=$(date -u +%FT%TZ); iso=$(date -u -r "$new" +%FT%TZ)
      { cat "$JS" 2>/dev/null || echo '{}'; } | jq --argjson u "$((new * 1000))" --arg at "$at" --arg why "$why" --arg iso "$iso" \
        '. + {ok:false, at:$at, cooldown_until:$u, blocked:true, error:("zen-gate trip: " + $why),
              remediation:("Zen 免費層 403：OpenCode 判本機出口 IP 濫用（由 dc／oc-free-check 偵測）。所有消費端停打至 " + $iso + "；解封要等上游。")}' \
        > "$tmp" 2>/dev/null && chmod 600 "$tmp" && mv "$tmp" "$JS" || rm -f "$tmp"
    fi
    if [ "$was_closed" = 0 ] && push_ok && command -v hpush >/dev/null; then
      hpush "⚠️ Zen 免費層判本機 IP 濫用（${why}），本機所有 Zen 免費消費端停打至 $(date -r "$new" '+%m-%d %H:%M')；dcq 走兜底層" >/dev/null 2>&1 || true
    fi
    echo "$new" ;;
  ok)
    # 上游有正常回應 → 失敗計數歸零（下次封鎖回到最短秒數）
    rm -f "$STREAK"
    exit 0 ;;
  halfopen)
    # 半開：閘已到期、但還有被封的紀錄 → 只准探測。沒有紀錄＝沒封過，沒半開可言。
    [ -f "$STREAK" ] || exit 1
    u=$(until_max)
    [ "$u" -le "$(date +%s)" ] || exit 1
    exit 0 ;;
  *) awk 'NR>1 && /^#/ { sub(/^# ?/,""); print; next } NR>1 { exit }' "$0"; exit 2 ;;
esac
