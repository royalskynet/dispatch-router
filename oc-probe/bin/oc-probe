#!/usr/bin/env bash
# oc-probe — dr 選配：偵測 opencode 模型清單變化，自動改 dr 的 OC 模型（catalog/models.tsv）。不碰 OmniRoute。
#   oc-probe        每日 06:00（launchd local.opencode-probe），全部零 token、不實打模型：
#                   1. dcq rescan：抓 Zen 上游 /models 清單，上下架回灌名單與清冊。
#                   2. go-sync：距上次滿 7 天才抓 Go 上游 /models。
#                   之後跑選配 hook（OC_PROBE_HOOK，預設 ~/.config/oc-probe/hook；不存在就略過）。
#                   2026-10-24 使用者定：不排程實打探測，出錯才處理——dcq 派工撞錯就冷卻／記 .gone、
#                   查清單決定恢復或下架；新模型由真實派工測，0 PASS 自動進冷宮。實打只剩手動 oc-probe probe。
#   oc-probe x      每 4 小時（launchd local.opencode-probe.x）：讀 @opencode 新推文；能讀出的改名／上下架記 x-pool.tsv。
#   oc-probe probe  強制探測一次；oc-probe sync 強制 go-sync 掃一次。
# 偵測到變化 → dcq sync-catalog 把增刪回寫清冊（無變動不改檔；清冊乾淨才自動 commit）。
# 只用 opencode run 探測，不 API 直打：Zen 免費層只認 opencode 客戶端，重試會被判濫用鎖 IP。
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LOGD="$HOME/.dcq/logs"
STAMP="$LOGD/oc-probe.last"
DCQ="${DCQ_BIN:-$HERE/../../bin/dcq}"
mkdir -p "$LOGD"

catalog_sync() {
  "$DCQ" sync-catalog --source "$1" || echo "oc-probe: dcq sync-catalog 失敗（rc=$?）"
}

full() {
  date +%s > "$STAMP"
  "$HERE/oc-free-check" -p opencode -j 4 -t 60 --tsv "$LOGD/probe.tsv"
  local probe_rc=$?
  catalog_sync "oc-probe 週探測"
  return $probe_rc
}

x_read() {
  "$HERE/oc-free-check" --x-only "$LOGD"
  local rc=$?
  [ "$rc" -eq 3 ] && { echo "oc-probe x: 推文提到清單變動，已記 x-pool（不提前探測）"; catalog_sync "@opencode 推文"; rc=0; }
  return $rc
}

hook() {
  local h="${OC_PROBE_HOOK:-$HOME/.config/oc-probe/hook}"
  [ -x "$h" ] || return 0
  "$h" || echo "oc-probe: hook 失敗（rc=$?）"
}

daily() {
  local rc=0
  "$DCQ" rescan || { echo "oc-probe: dcq rescan 失敗"; rc=1; }
  "$HERE/go-sync" || { echo "oc-probe: go-sync 失敗"; rc=1; }
  hook
  return $rc
}

case "${1:-daily}" in
  daily) daily; exit $? ;;
  probe) full; exit $? ;;
  sync) "$HERE/go-sync" --scan; exit $? ;;
  x) x_read; exit $? ;;
  *) echo "用法：oc-probe [daily|probe|sync|x]" >&2; exit 64 ;;
esac
