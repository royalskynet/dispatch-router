#!/bin/bash
# dcq-spinwatch：防空轉監看（零 token）。dcq 的 watchdog 只看 .out 有沒有輸出；
# 模型一直講話卻不改檔（讀檔繞圈、反覆重試同一招）不會被抓。這支看 cwd 的 git 改動：
# 同一次嘗試 SPIN_S 秒內工作樹完全沒變 → 殺掉這次嘗試的程序樹，dcq 照常記失敗、換下一隻模型。
# 用法：dcq-spinwatch [-s 秒] <job-id>=<cwd> ...   （每張工單的 cwd 要是 git 工作樹）
# 全部工單離開 pending/running 就自己結束。紀錄寫 ~/.dcq/logs/spinwatch.log。
Q="${DCQ_HOME:-$HOME/.dcq}"; SPIN_S=420; POLL="${SPIN_POLL:-30}"
[ "${1:-}" = "-s" ] && { SPIN_S="$2"; shift 2; }
[ $# -gt 0 ] || { echo "用法：dcq-spinwatch [-s 秒] <job-id>=<cwd> ..." >&2; exit 2; }
LOG="$Q/logs/spinwatch.log"; ST="$(mktemp -d)"
say() { echo "$(date '+%F %T') $*" | tee -a "$LOG"; }
tree_of() { local p="$1" c; echo "$p"; for c in $(pgrep -P "$p"); do tree_of "$c"; done; }
say "開始 SPIN_S=${SPIN_S}s：$*"
while :; do
  alive=0
  for pair in "$@"; do
    id="${pair%%=*}"; cwd="${pair#*=}"
    [ -e "$Q/running/$id.job" ] || [ -e "$Q/pending/$id.job" ] || continue
    alive=1
    pid="$(cat "$Q/running/$id.pid" 2>/dev/null)"; [ -n "$pid" ] || continue
    now=$(date +%s)
    s="$pid $( (git -C "$cwd" status --porcelain; git -C "$cwd" diff) 2>/dev/null | shasum | cut -c1-16)"
    if [ "$(cat "$ST/$id.sig" 2>/dev/null)" != "$s" ]; then   # 新嘗試或工作樹有變：重設計時
      echo "$s" > "$ST/$id.sig"; echo "$now" > "$ST/$id.t"; continue
    fi
    idle=$(( now - $(cat "$ST/$id.t") ))
    if [ "$idle" -ge "$SPIN_S" ]; then
      say "${id} 空轉：pid ${pid} 已 ${idle}s 沒改任何檔（${cwd}），殺掉換下一隻"
      kill $(tree_of "$pid") 2>/dev/null
      echo "$now" > "$ST/$id.t"
    fi
  done
  [ "$alive" = 1 ] || { say "全部工單結束，停止"; rm -rf "$ST"; exit 0; }
  sleep "$POLL"
done
